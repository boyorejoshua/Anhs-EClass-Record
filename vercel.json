{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash app/scripts/vercel-build.sh",
  "outputDirectory": "app/dist",
  "installCommand": "echo 'install runs inside the build script (no root package.json)'",
  "framework": null,
  "redirects": [
    { "source": "/legacy", "destination": "/legacy/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/legacy/", "destination": "/legacy/index.html" },
    { "source": "/((?!legacy/).*)", "destination": "/index.html" }
  ]
}
