{
  "name": "mendtrix-academic-records",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mendtrix School Academic Records & Grading Platform",
  "scripts": {
    "dev": "vite",
    "build": "npm run engine:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "engine:vendor": "node ../scripts/vendor-grading-engine.mjs",
    "engine:check": "node ../scripts/vendor-grading-engine.mjs --check",
    "e2e": "node e2e/recorded-grades.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:staging": "VITE_SINGLE_FILE=true VITE_DEMO_MODE=true VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build --outDir dist-staging && node scripts/build-staging.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
