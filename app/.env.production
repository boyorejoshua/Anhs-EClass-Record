# Loaded automatically by Vite for `vite build` (production mode).
#
# Both values are public by design. The anon key is a client credential:
# it authorises nothing on its own, because every table is FORCE ROW
# LEVEL SECURITY and every policy derives the tenant from the verified
# JWT via app.current_school_id(). An anonymous holder resolves a NULL
# tenant, so every policy fails closed, and migration 0017 revoked
# EXECUTE from `anon` on every function we own.
#
# They live here rather than in `buildCommand` because Vercel caps that
# field at 256 characters, and rather than only in the Vercel dashboard
# so that a local `npm run build` produces the same artifact as a deploy.
# Setting them in the dashboard still works — real environment variables
# take precedence over this file.
#
# NOT loaded by `npm run dev` (development mode) or by `build:staging`
# (which blanks them explicitly), so both keep running on fixtures.

VITE_SUPABASE_URL=https://wxkxdqwhefezjfmysypa.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind4a3hkcXdoZWZlempmbXlzeXBhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczODg3MDcsImV4cCI6MjEwMjk2NDcwN30.LhrSqzFbaHoj_ObN3h8A6yqpG41Lu6vO_YlgeqcgDss
