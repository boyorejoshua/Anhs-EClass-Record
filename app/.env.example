# Copy to .env.local for local development.

# Demo scaffolding: the "Preview as" role switcher and the tenant
# period-structure toggle. Both are review aids, not product.
# Leave unset in development (defaults on); set false for any build that
# goes in front of a school with real data.
VITE_DEMO_MODE=true

# Backend. While unset the app runs on fixtures in src/data/fixtures.ts.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
